{
  "api": 1,
  "importName": "claude-code-provider",
  "id": "claude-code-provider",
  "version": "2.12.5",
  "language": "typescript",
  "entry": "dist/plugin.js",
  "bundle": {
    "entry": "src/plugin.ts"
  },
  "displayName": "Claude Code",
  "icon": "icon.svg",
  "capabilities": {
    "provides": [
      "forebay.provider"
    ],
    "consumes": []
  },
  "services": {
    "provides": [
      "claude-code-provider:accounts"
    ],
    "consumes": [
      "accounts",
      "anthropic",
      "weivel.config",
      "weivel.secrets",
      "weivel.paths",
      "weivel.log"
    ]
  },
  "actions": {
    "login": {
      "label": "Sign in to Claude",
      "call": {
        "service": "claude-code-provider:accounts",
        "method": "login"
      },
      "input": {
        "code": {
          "type": "text",
          "label": "Authorization code",
          "help": "Leave empty to get the sign in url; after signing in, paste the code#state shown."
        }
      }
    },
    "accounts": {
      "label": "List accounts",
      "call": {
        "service": "claude-code-provider:accounts",
        "method": "list"
      }
    },
    "verify": {
      "label": "Verify access",
      "call": {
        "service": "claude-code-provider:accounts",
        "method": "verify"
      }
    },
    "refresh": {
      "label": "Refresh token",
      "call": {
        "service": "claude-code-provider:accounts",
        "method": "refresh"
      }
    },
    "quota": {
      "label": "Refresh quota",
      "call": {
        "service": "claude-code-provider:accounts",
        "method": "quota"
      }
    },
    "remove": {
      "label": "Remove account",
      "confirm": "Remove this account and its tokens?",
      "tone": "danger",
      "call": {
        "service": "claude-code-provider:accounts",
        "method": "remove"
      }
    }
  },
  "config": {
    "defaults": {
      "logging": true,
      "max_account_attempts": 4,
      "account_selection_strategy": "hybrid",
      "default_cooldown_seconds": 60,
      "max_cooldown_seconds": 900,
      "oauth_authorize_url": "https://claude.ai/oauth/authorize",
      "oauth_token_url": "https://platform.claude.com/v1/oauth/token",
      "api_base_url": "https://api.anthropic.com",
      "model_prefix": "claude-",
      "default_context": 200000,
      "default_output": 64000
    }
  },
  "access": [
    {
      "kind": "network",
      "target": "setting:oauth_token_url",
      "mode": "connect",
      "why": "signing in and refreshing an account's tokens"
    },
    {
      "kind": "network",
      "target": "setting:api_base_url",
      "mode": "connect",
      "why": "requests, model lists, quota and verification go to the Anthropic API"
    }
  ],
  "repo": {
    "role": "Claude Code (Anthropic) provider",
    "category": "ai-provider",
    "domains": [
      "claude",
      "anthropic"
    ],
    "tech": [
      "typescript"
    ]
  }
}
